# Required server-only values. Never put real secrets in this tracked file.
# Mainnet reference requires SIP; the Devnet demo does not use SIP.
API_ALPACA=
API_ALPACA_SECRET=
SOLSTOCK_RPC_HTTP=
SOLSTOCK_RPC_WS=
SOLSTOCK_BACKUP_RPC_HTTP=
SOLSTOCK_DATABASE_URL=
# Absolute paths. Keeper JSON must be mode 0600 and owned by the service user.
SOLSTOCK_KEEPER_FILE=
SOLSTOCK_GUARD_MANIFEST=
SOLSTOCK_PUBLIC_ORIGIN=
SOLSTOCK_PORT=
# Explicit operator-approved bounds; no spending defaults are supplied.
SOLSTOCK_COMPUTE_UNITS=
SOLSTOCK_PRIORITY_MICROLAMPORTS=
SOLSTOCK_MAX_FEE_LAMPORTS=

# Free Devnet demo
# Values only; no real keys. Never use a mainnet wallet for this demo.
SOLSTOCK_DEMO=devnet
SOLSTOCK_DEMO_ORIGIN=http://localhost:3107
SOLSTOCK_DEMO_ENV=/absolute/path/to/devnet-environment.json
SOLSTOCK_DEMO_ALPACA_FILE=/absolute/path/to/optional-alpaca-credentials.json
# Runtime operator: secrets/devnet-demo-operator-keypair.json (0600, Devnet only).
# Fixture creation and program deployment are documented in docs/29_DEVNET_DEMO.md.
